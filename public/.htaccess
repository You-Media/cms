<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve _next assets directly (critical for Next.js static export)
  RewriteRule ^_next/ - [L]
  
  # Serve static assets directly (images, fonts, etc.)
  RewriteRule ^(.*\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))$ - [L]
  
  # Serve JSON data files directly
  RewriteRule ^(.*\.json)$ - [L]

  # Serve existing files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If a directory-specific index.html exists (from next export), serve it
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # If a direct .html exists (from next export), serve it
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # Route everything else to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>
